<?xml version="1.0" encoding="UTF-8"?>

<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="osm.net.xml"/>
        <route-files value="osm.rou.xml"/>
        <additional-files value="additional.add.xml"/>
    </input>

    <output>
        <tripinfo-output value="tripinfo.xml"/>
    </output>

    <time>
        <begin value="0"/>
        <end value="7200"/>
        <step-length value="1.0"/>
    </time>

    <processing>
        <ignore-route-errors value="false"/>
        <lateral-resolution value="0"/>
        <lanechange.duration value="2"/>
        <ignore-junction-blocker value="60"/>
        <collision.action value="warn"/>
        <time-to-teleport value="-1"/>
        <max-depart-delay value="1800"/>
        <time-to-impatience value="120"/>
        <pedestrian.model value="striping"/>
        <pedestrian.striping.stripe-width value="0.55"/>
        <pedestrian.striping.jamtime value="60"/>
    </processing>

    <routing>
        <device.rerouting.probability value="0"/>
        <person-device.rerouting.probability value="0"/>
    </routing>

    <random_number>
        <seed value="42"/>
    </random_number>

    <report>
        <no-step-log value="true"/>
        <duration-log.statistics value="true"/>
    </report>

</configuration>

