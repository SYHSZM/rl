<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- ===================== -->
    <!-- Vehicle Types -->
    <!-- ===================== -->

    <!-- Heavy vehicle (conservative lane-changing) -->
    <vType accel="1.45" carFollowModel="IDM" color="green" decel="4.00" delta="3.65" emergencyDecel="9.00"
           id="Heavy_Vehicle"
           lcAssertive="0.30"
           lcKeepRight="0.50"
           lcPushy="0.0"
           lcImpatience="0.0"
           minGapLat="0.8"
           maxSpeedLat="0.8"
           length="11.20" maxSpeed="25.00"
           minGap="4.09" probability="1.00"
           sigma="0.20" speedDev="0.05" speedFactor="1.20" tau="1.80"
           vClass="truck"/>

    <!-- Car (conservative lane-changing) -->
    <vType accel="1.02" carFollowModel="IDM" color="blue" decel="4.50" delta="2.07" emergencyDecel="9.00"
           id="Car"
           lcAssertive="0.60"
           lcKeepRight="0.50"
           lcPushy="0.0"
